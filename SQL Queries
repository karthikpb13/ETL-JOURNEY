33) RESTAURANT GROWTH (MOVING AVERAGE)

SELECT * FROM 
(
SELECT DISTINCT TO_CHAR(visited_on + 6, 'YYYY-MM-DD') AS visited_on ,SUM(AMOUNT)OVER(ORDER BY visited_on  RANGE BETWEEN CURRENT ROW
           AND INTERVAL '6' DAY FOLLOWING) AS AMOUNT, 
                  ROUND(SUM(AMOUNT) OVER(ORDER BY visited_on  RANGE BETWEEN CURRENT ROW
