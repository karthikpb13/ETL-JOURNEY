--> ALL STUDENT

SELECT student,
       CASE
           WHEN maths <= physics AND maths <= chemistry THEN 'Maths'
           WHEN physics <= chemistry THEN 'Physics'
           ELSE 'Chemistry'
       END AS lowest_subject,
       LEAST(maths, physics, chemistry) AS lowest_mark
FROM students;


--> HOW MANY STUDENTS ARE WEAKEST IN EACH SUBJECT 

SELECT lowest_subject, COUNT(*) AS student_count
FROM (
    SELECT CASE
               WHEN maths <= physics AND maths <= chemistry THEN 'Maths'
               WHEN physics <= chemistry THEN 'Physics'
               ELSE 'Chemistry'
           END AS lowest_subject
    FROM students
) t
GROUP BY lowest_subject;


