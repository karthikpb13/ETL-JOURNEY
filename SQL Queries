9) FIND TOTAL RUNNING SUM

SELECT DATE, AMOUNT, SUM(AMOUNT) OVER (ORDER BY DATE) AS RUNNING _SUM
FROM SALES;

10) CATEGORIZE EMPLOYEE BASED ON SLARY 

SELECT NAME, SALARY , 
  CASE 
      WHEN SALARY > = 10000 THEN 'HIGH'
      WHEN SALARY BETWEEN 5000 AND 9999 THEN 'MID'
      ELSE 'LOW'
  END AS SALARY_COMPARISON
FROM EMPLOYEE;

