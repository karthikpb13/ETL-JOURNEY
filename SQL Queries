1) Find Duplicate Records
SELECT EMAIL,COUNT(*) AS CNT
FROM EMPLOYEE
GROUP BY EMAIL
HAVING CONT(*) > 1;

2) Find Nth highest salary  Third highest
SELECT DISTINCT SALARY
FROM EMPLOYEE
ORDER BY SALARY 
LIMIT 1 OFFSET 2;

3) Find Missing numbers

SELECT LEVEL FROM DUAL
CONNECT BY LEVEL < = (SELECT MAX(ID) FROM TABLE)
MINUS
SELECT ID FROM TABLE;

4) Find NULL values
SELECT * 
FROM EMPLOYEE
WHERE DEPARTMENT IS NULL;

5) Delete Duplicate keep one
DELETE FROM EMPLOYEE
WHERE ID NOT IN (
          SELECT MAX(ID) 
          FROM EMPLOYEE
          GROUP BY EMAIL
);

DELETE FROM EMPLOYEE
WHERE ID IN (
    SELECT ID
    FROM (
        SELECT ID, EMAIL, ROW_NUMBER() OVER ( PARTITION BY EMAIL ORDER BY ID) AS RN
        FROM EMPLOYEE
    )
    WHERE RN > 1
);

6) Find second highest records

SELECT DISTINCT SALARY
FROM EMPLOYEE
ORDER BY SALARY DESC
LIMIT 1 OFFSET 1;

SELECT MAX(SALARY) AS SEC_HIGH_SAL
FROM EMPLOYEE
WHERE SALARY < (SELECT MAX(SALARY) FROM EMPLOYEE);

