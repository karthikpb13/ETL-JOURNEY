13) FIND CUSTOMERS WHO PLACED ORDERS EVERY MONTH 

SELECT CUSTOMER_ID
FROM ORDERS 
WHERE EXTRACT(YEAR FROMM ORDER_DATE)M =2023
GROUP BY CUSTOMER_ID
HAVING COUNT(DISTINCT TO_CHAR(ORDER_DATE, 'YYYY-MM')) =12;

14)  FIND MOVING AVERAGE SALES OVER THE LAST 3 DAYS

SELECT ORDER_DATE, 
       AVG(TOTAL_AMOUNT) OVER (ORDER BY ORDER_DATE ROWS BETWEEN 2 PRECEEDING AND CURRENT ROW) AS MOVING_AVG
FROM ORDERS;

15) IDENTIFY TOP-PERFORMING DEPARTMENT BY AVERAGE SALARY 

SELECT DEPARTMENT_ID, AVG(SALARY) AS AVG_SAL
FROM EMPLOYEE
GROUP BY DEPARTMENT_ID
ORDER BY AVG_SAL DESC;

16) FIND CHURNED CUSTOMERS (NO ORDERS IN THE LAST 6 MONTHS)
SELECT CUSTOMER_ID
FROM ORDERS
GROUP BY CUSTOMER_ID
HAVING MAX(ORDER_DATE) < ADD_MONTHS( SYSDATE , -6);

SELECT CUSTOMER_ID
FROM ORDERS
GROUP BY CUSTOMER_ID
HAVING MAX(ORDER_DATE) < ADD_MONTHS(CURRENT_DATE(), -6);  -- DATABRICKS 

17) GET TOTAL REVENUE AND NUMBERS OF ORDERS PER REGION
SELECT REGION, SUM(ORDER_AMOUNT) AS TOT_AMOUNT, COUNT(*) AS ORD_CNT
FROM ORDERS
GROUP BY REGION;

