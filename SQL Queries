19) TRIANGLE JUDGEMENT 
SELECT X,Y,Z, CASE 
        WHEN X+Y > Z AND Y+Z > X AND Z+X > Y THEN 'Yes'
        ELSE 'No'
        END 
AS TRIANGLE
FROM TRIANGLE;

20) CONSECUTIVE NUMBERS

SELECT DISTINCT NUM AS ConsecutiveNums
FROM
(
    SELECT NUM, LEAD(NUM,1)OVER(ORDER BY ID) NXT1, LEAD(NUM,2) OVER (ORDER BY ID) AS NXT2
    FROM LOGS
)
WHERE NUM=NXT1 AND NUM=NXT2; 

21) CUSTOMER WHO BROUGHT EVERY PRODUCT 

