FROM CUSTOMER
GROUP BY CUSTOMER_ID 
HAVING COUNT(DISTINCT PRODUCT_KEY) = (SELECT COUNT(DISTINCT PRODUCT_KEY) FROM PRODUCT);

22) SHOW EACH CUSTOMERS RUNNING WALLET BALANCE AFTER EVERY TRANSACTION 

SELECT CUSTOMER_ID, TXN_TYPE,AMOUNT,
SUM(
          CASE
          WHEN TXN_TYPE="CREDIT" THEN AMOUNT
          WHEN TXN_TYPE="DEBIT" THEN -AMOUNT
          END
    ) OVER (PARTIOTION BY CUTOMER_ID ORDER BY TXN_DATE) AS RUNNING_BALANCE
FROM TRANSACTIONS;


